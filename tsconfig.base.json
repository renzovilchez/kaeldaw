{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "paths": {
      "@kaeldaw/audio-engine": ["./packages/audio-engine/src"],
      "@kaeldaw/audio-engine/*": ["./packages/audio-engine/src/*"],
      "@kaeldaw/instruments": ["./packages/instruments/src"],
      "@kaeldaw/instruments/*": ["./packages/instruments/src/*"],
      "@kaeldaw/mixer": ["./packages/mixer/src"],
      "@kaeldaw/mixer/*": ["./packages/mixer/src/*"],
      "@kaeldaw/plugin-system": ["./packages/plugin-system/src"],
      "@kaeldaw/plugin-system/*": ["./packages/plugin-system/src/*"],
      "@kaeldaw/project": ["./packages/project/src"],
      "@kaeldaw/project/*": ["./packages/project/src/*"],
      "@kaeldaw/sequencer": ["./packages/sequencer/src"],
      "@kaeldaw/sequencer/*": ["./packages/sequencer/src/*"],
      "@kaeldaw/shared": ["./packages/shared/src"],
      "@kaeldaw/shared/*": ["./packages/shared/src/*"],
      "@kaeldaw/ui-controls": ["./packages/ui-controls/src"],
      "@kaeldaw/ui-controls/*": ["./packages/ui-controls/src/*"],
      "@kaeldaw/ui-kit": ["./packages/ui-kit/src"],
      "@kaeldaw/ui-kit/*": ["./packages/ui-kit/src/*"]
    }
  }
}
